# Copy to .env (or .env.local) and fill in real values. Never commit real values.
# DATABASE_URL is REQUIRED at runtime. If missing, Prisma runs in deferred mode
# and every database call fails.
# PostgreSQL (production / local docker): postgresql://USER:PASSWORD@HOST:5432/freelance_copilot?schema=public
# NOTE: the schema provider is "postgresql" — the sqlite path in src/lib/db.ts
# is NOT compatible with the generated client and cannot be used as a local DB.
DATABASE_URL=

# Required by /api/auth/login (admin) and /api/sync (Bearer). Also used as the
# HMAC signing key for admin + guest session cookies. Must be a long random value.
CRON_SECRET=

# Admin credentials for /api/auth/login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: enables real AI analysis / job fetching. Without these, analysis
# falls back to local heuristics and Apify/SerpApi providers return empty.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=
APIFY_TOKEN=
# Second authorized Apify account. With both APIFY_TOKEN and APIFY_TOKEN2 set,
# the Upwork query workload is split deterministically across the two accounts
# (each serves half the queries); with only one set, it serves all queries.
APIFY_TOKEN2=
# Third authorized Apify account. With APIFY_TOKEN, APIFY_TOKEN2, and
# APIFY_TOKEN3 set, the Upwork query workload is split across all three. If one
# account hits its usage limit or fails, the provider automatically fails over
# to another available account for the rest of the run.
APIFY_TOKEN3=
SERPAPI_KEY=
