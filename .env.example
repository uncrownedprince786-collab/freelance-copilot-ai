# Copy to .env (or .env.local) and fill in real values. Never commit real values.
# DATABASE_URL is REQUIRED at runtime. If missing, Prisma runs in deferred mode
# and every database call fails.
# PostgreSQL (production / local docker): postgresql://USER:PASSWORD@HOST:5432/freelance_copilot?schema=public
DATABASE_URL=

# Required by /api/auth/login (admin) and /api/sync (Bearer). Also used as the
# HMAC signing key for admin + guest session cookies. Must be a long random value.
CRON_SECRET=

# Admin credentials for /api/auth/login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# AI analysis keys. Without these, analysis falls back to local heuristics.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROK_API_KEY=
DEEPSEEK_API_KEY=

# Apify accounts for Upwork scraping. Queries are split deterministically
# across configured accounts with automatic failover on quota/auth errors.
APIFY_TOKEN=
APIFY_TOKEN2=
APIFY_TOKEN3=
