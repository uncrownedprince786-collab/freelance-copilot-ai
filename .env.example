# Copy to .env (or .env.local) and fill in real values. Never commit real values.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
# If missing, Prisma runs in deferred mode and every database call fails.
# Neon: use the POOLED connection string (host contains "-pooler") for the app.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs admin + guest session cookies. MUST be a long random value, and MUST be
# different from CRON_SECRET: CRON_SECRET is sent as a Bearer header to
# /api/sync on every scheduled run, so it is exposed to CI logs and proxies —
# reusing it as the cookie signing key would let anyone who saw that header
# mint admin sessions. Rotating this value invalidates all live sessions.
# If unset, the app falls back to CRON_SECRET for backwards compatibility.
SESSION_SIGNING_SECRET=

# Bearer token for the scheduled /api/sync and /api/sync/refresh calls.
CRON_SECRET=

# Admin credentials for /api/auth/login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AI providers (optional; analysis falls back to local heuristics without them)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Groq (api.groq.com) and xAI/Grok (api.x.ai) are DIFFERENT vendors with
# different key formats. They previously shared one variable, so whichever was
# set, the other provider always failed auth and that fallback tier was dead.
GROQ_API_KEY=
XAI_API_KEY=

# Deprecated: read as a fallback for both of the above. Prefer the two names.
GROK_API_KEY=

# ---------------------------------------------------------------------------
# Apify (Upwork scraping)
# ---------------------------------------------------------------------------
# Queries are split deterministically across configured accounts with automatic
# failover on quota/auth errors.
APIFY_TOKEN=
APIFY_TOKEN2=
APIFY_TOKEN3=

# Hard daily cap on billed Apify query-runs, shared by sync and refresh.
# The actor is pay-per-event against a $5/month free tier, so this is the main
# spend control. Default 16.
APIFY_DAILY_QUERY_BUDGET=

# Billed Apify runs reserved for NEW-JOB DISCOVERY. The active-job refresher
# may only spend what is above this floor, so re-checking listings already in
# the database can never consume the budget needed to find new ones.
# Measured basis: Upwork yields 66% useful leads to Freelancer's 10%, and the
# proposal counts the refresher exists to update do not move with age.
# Default 8 (of the 16 above). Set to 0 to restore the old shared pool.
APIFY_DISCOVERY_RESERVE=

# Billed Apify runs one discovery pass costs (the query list in
# ApifyUpworkProvider). Used to work out how many discovery runs the daily
# budget affords, so spend can be concentrated in the highest-yield hours.
# Default 4.
APIFY_QUERIES_PER_RUN=

# How often post-sync quality maintenance (duplicate clustering + assessment
# refresh) may run, in minutes. Clustering reads every row, so running it on
# every sync would be ten full-table reads a day on a free-tier database to
# usually find nothing new. Default 180.
QUALITY_MAINTENANCE_INTERVAL_MIN=
