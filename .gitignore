# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel

# runtime artifacts (never commit)
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
applied-jobs.json
viewed-jobs.json
upwork-jobs.json
sync-results.json
.jobs-cache.json
.cron-logs.json
.upwork-quota.json

# one-off investigation probes (never commit)
/scratch/
