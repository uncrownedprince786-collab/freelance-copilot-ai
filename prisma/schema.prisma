generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Opportunity {
  id          String    @id @default(uuid())
  title       String
  description String
  budget      String
  platform    String
  url         String    @unique
  createdAt   DateTime  @default(now())
  score       Int       @default(0)
  risk        String    @default("Medium")
  viewed      Boolean   @default(false)
  viewedAt    DateTime?
  
  status            String    @default("OPEN")
  country           String?
  clientName        String?
  clientSpend       String?
  clientReviews     String?
  connections       Int?
  budgetType        String?
  experienceLevel   String?
  duration          String?
  skills            String?
  proposalCount     Int?
  interviewingCount Int?      @default(0)
  hiresCount        Int?      @default(0)
  paymentVerified   Boolean   @default(false)
  clientRating      String?
  jobsPosted        Int?
  applied           Boolean   @default(false)
  appliedAt         DateTime?
  rawPayload        String?

  // Relations
  analysis    Analysis?
  tracking    ProjectTracking?

  @@index([platform])
  @@index([score])
  @@index([createdAt])
  @@index([viewed])
  @@index([platform, score])
  @@index([platform, createdAt])
  @@index([applied, createdAt])
  @@map("opportunities")
}

model Analysis {
  id                String      @id @default(uuid())
  opportunityId     String      @unique
  opportunity       Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  summary           String
  scope             Json
  riskAnalysis      Json
  bidRecommendation Json
  questions         Json
  
  proposal          String
  
  createdAt         DateTime    @default(now())

  @@map("analyses")
}

model ProjectTracking {
  id            String      @id @default(uuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  
  status        String
  updatedAt     DateTime    @updatedAt

  @@map("project_tracking")
}

model UserSession {
  id         String    @id @default(uuid())
  guestId    String    @unique
  role       String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  durationMs Int?
  lastSeen   DateTime  @default(now())
  events     String    // JSON stringified SessionEvent[]

  @@map("user_sessions")
}

model CronLog {
  id            String   @id @default(uuid())
  timestamp     DateTime @default(now())
  status        String
  jobsFetched   Int
  newJobsAdded  Int
  sourceSummary String

  @@map("cron_logs")
}

model SystemKv {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_kv")
}

// Lightweight historical intelligence. Raw jobs expire per retention rules,
// but these aggregate facts persist so the system can learn posting volume,
// platform/skill activity, posting hours, budgets, competition and client
// frequency over time — without keeping the raw listings.
model MarketFact {
  id        String   @id @default(uuid())
  date      String   // YYYY-MM-DD (UTC posting date)
  dimension String   // volume | platform | skill | hour | day | budget | engagement | competition | proposals | client
  key       String   // 'all' | 'Upwork' | 'react' | '7' | 'Mon' | '$500–$2k' | 'hourly' | 'low' | clientKey
  value     Float
  updatedAt DateTime @updatedAt

  @@unique([date, dimension, key])
  @@index([dimension, key])
  @@index([date])
  @@map("market_facts")
}